rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Hanya akun Google (bukan anonim).
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function isFamilyMember(fid) {
      return signedIn()
        && exists(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid));
    }
    function isOwner(fid) {
      return signedIn()
        && get(/databases/$(database)/documents/families/$(fid)).data.ownerUid == request.auth.uid;
    }

    // Profil: milik sendiri.
    match /users/{u} {
      allow read: if signedIn() && request.auth.uid == u;
      allow create, update: if signedIn() && request.auth.uid == u
        && request.resource.data.keys().hasOnly(['familyId', 'name', 'email', 'photo', 'updatedAt']);
      allow delete: if false;
    }

    // Peta keluarga.
    match /families/{fid} {
      allow read: if isFamilyMember(fid);
      // Ruang data lama "main" hanya boleh diklaim pemilik. GANTI email di bawah dengan email Google pemilik
      // (SAMA dengan LEGACY_OWNER_EMAIL di index.html).
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'inviteCode', 'createdAt'])
        && (fid != 'main' || (request.auth.token.email_verified == true
                              && request.auth.token.email == 'GANTI_EMAIL_PEMILIK@gmail.com'));
      allow update: if isOwner(fid) && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;

      match /members/{m} {
        allow read: if isFamilyMember(fid);
        // Pemilik mendaftarkan dirinya, atau anggota baru dengan kode undangan yang benar.
        allow create: if signedIn() && request.auth.uid == m
          && request.resource.data.keys().hasOnly(['role', 'name', 'email', 'photo', 'joinedAt', 'code'])
          && (
            (request.resource.data.role == 'owner' && isOwner(fid))
            || (request.resource.data.role == 'member'
                && request.resource.data.code == get(/databases/$(database)/documents/families/$(fid)).data.inviteCode)
          );
        allow update: if isFamilyMember(fid) && request.auth.uid == m
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photo']);
        allow delete: if isOwner(fid) || (signedIn() && request.auth.uid == m);
      }
    }

    // Kode undangan -> id keluarga. Hanya bisa dibaca per kode (tanpa daftar).
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['familyId'])
        && isOwner(request.resource.data.familyId)
        && get(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.inviteCode == code;
      allow delete: if signedIn() && isOwner(resource.data.familyId);
      allow update: if false;
    }

    // Semua data app (kas, emas, kucing, lokasi, riwayat, tempat, CCTV, kabar) per keluarga.
    match /bukukas_shared/{fid} {
      allow read, delete: if isFamilyMember(fid);
      allow create, update: if isFamilyMember(fid) && request.resource.data.keys().size() <= 60;
    }
    // Lokasi: tiap anggota hanya boleh menulis dokumennya sendiri (id = uid). Anggota lain hanya boleh "ping".
    function validLoc(d) {
      return (!('lat' in d) || d.lat == null || (d.lat is number && d.lat >= -90 && d.lat <= 90))
          && (!('lng' in d) || d.lng == null || (d.lng is number && d.lng >= -180 && d.lng <= 180))
          && d.keys().size() <= 30;
    }
    match /bukukas_shared/{fid}/locations/{lid} {
      allow read: if isFamilyMember(fid);
      allow create, update: if isFamilyMember(fid) && (
        (request.auth.uid == lid && validLoc(request.resource.data))
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pingAt', 'pingBy'])
      );
      allow delete: if isFamilyMember(fid) && (request.auth.uid == lid || isOwner(fid));
    }
    match /bukukas_shared/{fid}/locations/{lid}/{sub=**} {
      allow read: if isFamilyMember(fid);
      allow write: if isFamilyMember(fid) && request.auth.uid == lid;
    }

    // Koleksi lain (kas, emas, dst.), kecuali "locations" yang punya aturan sendiri di atas.
    match /bukukas_shared/{fid}/{col}/{docId=**} {
      allow read, delete: if isFamilyMember(fid) && col != 'locations';
      allow create, update: if isFamilyMember(fid) && col != 'locations' && request.resource.data.keys().size() <= 60;
    }

    match /{other=**} {
      allow read, write: if false;
    }
  }
}
