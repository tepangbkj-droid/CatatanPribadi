rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perangkat dianggap "anggota" jika punya dokumen members/{uid}.
    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    // --- OPSI TERKUAT (disarankan): batasi ke akun Google keluarga ---
    // Jika nanti app memakai Login Google, ganti isMember() di bawah dengan:
    //   request.auth != null
    //   && request.auth.token.email_verified == true
    //   && request.auth.token.email in ['ayah@gmail.com', 'ibu@gmail.com', 'adik@gmail.com']
    // Dengan cara ini hash kode akses tidak lagi menjadi satu-satunya kunci.

    // Dokumen anggota hanya bisa dibuat kalau kode akses benar.
    // GANTI nilai di bawah dengan hash dari app (Pengaturan > Info > Buat hash kode akses),
    // dan nilai yang SAMA harus ada di ACCESS_CODE_HASH di index.html.
    // PENTING: jangan simpan repo ini sebagai PUBLIK bila hash terisi (lihat KEAMANAN.md).
    match /members/{uid} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'at'])
        && request.resource.data.code == 'GANTI_DENGAN_HASH_KODE_AKSES';
      allow read: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if false;
    }

    // Semua data app (kas, emas, kucing, lokasi, riwayat, tempat, CCTV, kabar) hanya untuk anggota.
    // Batas ukuran dokumen & jumlah field mencegah "sampah" besar dikirim lewat akun yang bocor.
    match /bukukas_shared/{document=**} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.keys().size() <= 60;
      allow delete: if isMember();
    }

    // Semua jalur lain ditolak.
    match /{other=**} {
      allow read, write: if false;
    }
  }
}
